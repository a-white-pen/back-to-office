# Local settings. Keep .env private; .env.example uses safe placeholders.

# Databricks. A blank warehouse id lets the client discover one.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=
DATABRICKS_WAREHOUSE_ID=

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Gemini job-listing triage and detail extraction
GEMINI_TRIAGE_JOBS_API_KEY=
GEMINI_EXTRACT_JOB_DETAILS_API_KEY=

# Apify: shared by collection and contact finding
APIFY_TOKEN=

# Brave job-listing research, employer search, people search and person lookup
BRAVE_FIND_DIRECT_LINK_API_KEY=
BRAVE_FIND_EMPLOYER_API_KEY=
BRAVE_FIND_PEOPLE_API_KEY=
BRAVE_LOOK_UP_PERSON_API_KEY=

# Hunter contact lookup
HUNTER_API_KEY=

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Review publication: web address and admin credentials
BTO_REVIEW_REFRESH_URL=
BTO_REVIEW_REFRESH_USERNAME=
BTO_REVIEW_REFRESH_PASSWORD=
