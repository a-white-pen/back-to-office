[Unit]
Description=Back to Office filter and bucket cleaned job listings
Wants=network-online.target
After=network-online.target postgresql.service clean-job-listings.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/bto
EnvironmentFile=/etc/bto/env
UMask=0077
ExecStart=/opt/bto/.venv/bin/python -m bto.filter_and_bucket_job_listings.run --mode night --allow-gemini --refresh-review --send-email
# A healthy Batch runs to its remote terminal state; no wall-clock cutoff.
TimeoutStartSec=infinity
ExecStopPost=-/opt/bto/.venv/bin/python -m bto.send_notifications.notify --service-failure filter-and-bucket-job-listings
SyslogIdentifier=filter-and-bucket-job-listings
StandardOutput=journal
StandardError=journal
