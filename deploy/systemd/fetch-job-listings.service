# Back to Office — nightly job listing collection (fetch_job_listings).
# One complete chain per timer firing. stdout/stderr go to journald:
#   journalctl -u fetch-job-listings
# No automatic restart: interrupted upstream work needs inspection; Batch
# resumes the saved remote job and never repeats an ambiguous submission.

[Unit]
Description=Back to Office nightly collection, cleaning and sorting
Wants=network-online.target
After=network-online.target postgresql.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/bto
EnvironmentFile=/etc/bto/env
Environment=BTO_COMBINED_NIGHTLY_EMAIL=1
UMask=0077
ExecStart=/opt/bto/.venv/bin/python -m bto.nightly --wheel /opt/bto/wheels --allow-gemini --send-email
# Batch owns its terminal state; a healthy remote job has no morning cutoff.
TimeoutStartSec=infinity
# Best-effort terminal alert for a failure Python could not report.
ExecStopPost=-/opt/bto/.venv/bin/python -m bto.send_notifications.notify --service-failure fetch-job-listings
SyslogIdentifier=fetch-job-listings
StandardOutput=journal
StandardError=journal
