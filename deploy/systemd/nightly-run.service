# Back to Office — complete nightly run.
# One complete chain per timer firing. stdout/stderr go to journald:
#   journalctl -u nightly-run
# No automatic restart: interrupted upstream work needs inspection; Batch
# resumes the saved remote job and never repeats an ambiguous submission.

[Unit]
Description=Back to Office nightly run
Wants=network-online.target
After=network-online.target postgresql.service
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/bto
EnvironmentFile=/etc/bto/env
Environment=BTO_COMBINED_NIGHTLY_EMAIL=1
UMask=0077
ExecStart=/opt/bto/.venv/bin/python -m bto.nightly_run --wheel /opt/bto/wheels --allow-gemini --send-email
# The sorting command waits for its Review publication child before terminal email.
# Batch owns its terminal state; a healthy remote job has no morning cutoff.
TimeoutStartSec=infinity
# Best-effort terminal alert for a failure Python could not report.
ExecStopPost=-/opt/bto/.venv/bin/python -m bto.send_notifications.notify --service-failure nightly-run
SyslogIdentifier=nightly-run
StandardOutput=journal
StandardError=journal
