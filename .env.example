# Copy to .env and fill in. Never commit .env.

# ─── Databricks ──────────────────────────────────────────────
# Credentials need access to Unity Catalog files and tables, a SQL warehouse,
# and job submission and status APIs.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
# Catalog is configuration, never a hardcode.
DATABRICKS_CATALOG=bto
# DATABRICKS_WAREHOUSE_ID=          # optional; auto-discovered when blank

# ─── PostgreSQL ──────────────────────────────────────────────
# The box listens on localhost only. Port 15432 assumes a tunnel:
#   ssh -f -N -L 15432:127.0.0.1:5432 bto
# On the box itself, use port 5432.
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=
PGUSER=
PGPASSWORD=

# ─── Apify ───────────────────────────────────────────────────
APIFY_TOKEN=

# ─── Email ───────────────────────────────────────────────────
# Unset means alerts are logged, not emailed. Port 465 is implicit TLS,
# anything else STARTTLS. The From address is SMTP_USERNAME.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# ─── Gemini (Triage only; separate key per LLM stage) ──────────
GEMINI_TRIAGE_API_KEY=
