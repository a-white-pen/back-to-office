# Back to Office — the fetch-execution summary email (python -m bto summarise --collection-problems-only).
# Standalone coverage report scoped by data/last_fetch.json. The complete
# nightly workflow owns its terminal email and never starts this unit.
# There is no summary timer; manual fetches retain their own notifications.

[Unit]
Description=Back to Office collection failure and coverage-loss email

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/bto
EnvironmentFile=/etc/bto/env
ExecStart=/opt/bto/.venv/bin/python -m bto summarise --collection-problems-only
TimeoutStartSec=15min
SyslogIdentifier=send-job-listings-summary-email
StandardOutput=journal
StandardError=journal
